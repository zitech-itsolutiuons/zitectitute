MONGODB_URI=mongodb://localhost:27017/coursecraft
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=
# Encrypts downloadable MongoDB backups; use a separate random secret of 32+ characters.
BACKUP_ENCRYPTION_KEY=
# Optional exact host allowlist for embedding protected course media, comma-separated.
VIDEO_ALLOWED_DOMAINS=
# Optional independent HMAC key for signed course media URLs (falls back to AUTH_SECRET).
VIDEO_SIGNING_SECRET=
# Paystack secret key (server-side only). Use a test key while validating checkout.
PAYSTACK_SECRET_KEY=
# Optional self-hosted Piston-compatible runner for Python, Java, and C code practice.
# Keep this endpoint private to the app server; never expose a public execution API.
# CODE_RUNNER_URL=http://piston:2000
# Only needed when self-hosting behind a proxy (Vercel sets this for you):
# AUTH_TRUST_HOST=true

# Enable a provider by setting its id + secret. Callback URLs to register:
#   {your-origin}/api/auth/callback/google
#   {your-origin}/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
